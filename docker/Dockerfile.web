# Stage 1: Build Angular frontend
FROM node:24-alpine AS build

# Install pnpm (matching packageManager in package.json)
RUN npm install -g pnpm@10.33.0

WORKDIR /app

# Copy dependency files
COPY web/package.json web/pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy configurations and source files
COPY web/tsconfig.json web/tsconfig.app.json web/angular.json web/ngsw-config.json web/.postcssrc.json ./
COPY web/src ./src
COPY web/public ./public

# Build frontend (outputs to dist/start-base/browser)
RUN pnpm build

# Stage 2: Serve using Nginx
FROM nginx:alpine

# Copy built files to Nginx html directory
COPY --from=build /app/dist/start-base/browser /usr/share/nginx/html

# Copy custom Nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
